# ===========================================
# IP-SAKTI Sahayak — Environment Variables
# Set these in Vercel Project Settings > Environment Variables
# ===========================================

# PostgreSQL Database URL (required)
# Get a free one from https://neon.tech
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# NVIDIA Build API Key (primary AI engine - recommended)
# Get yours at https://build.nvidia.com
NVIDIA_API_KEY=

# OpenRouter API Key (fallback AI engine)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=
